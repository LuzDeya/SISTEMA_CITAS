PORT=4000
# --- Opción 1 (recomendada): MongoDB LOCAL ---
MONGO_URI=mongodb://127.0.0.1:27017/reservas
MONGO_URI_TEST=mongodb://127.0.0.1:27017/reservas_test
# --- Opción 2: MongoDB ATLAS (comenta las 2 líneas de arriba y descomenta estas) ---
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/reservas?retryWrites=true&w=majority
# MONGO_URI_TEST=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/reservas_test?retryWrites=true&w=majority
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:5173
